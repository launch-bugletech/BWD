ementor-icon{width:50px;height:50px;border-radius:14px;background:rgba(1,78,178,.06);color:#1E76BE;display:inline-flex;align-items:center;justify-content:center;font-size:24px;margin-bottom:18px;} selector .bwd-outcome-card .elementor-icon-box-title{margin:0 0 10px 0;} selector .bwd-outcome-card .elementor-icon-box-description{margin:0;} @media(max-width:1024px){selector .bwd-outcomes-wrap{grid-template-columns:1fr;} selector .bwd-outcome-feature-card{min-height:auto;}} @media(max-width:768px){selector .bwd-outcome-grid{grid-template-columns:1fr;} selector .bwd-outcome-card-wide{grid-column:span 1;} selector .bwd-outcome-feature-card{padding:34px 26px;border-radius:22px;}}"
